# No variables: offline Python sample; browser saves only.
# Account-free full demo: set AI_MODE=mock and leave all keys/DB blank.
AI_MODE=mock

# Neon Free pooled Postgres URL; Singapore aws-ap-southeast-1.
# Use a separate Neon branch for testing. Never commit the real URL.
DATABASE_URL=

# Free Google AI Studio key. Set AI_MODE=live for real generation.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FAST_MODEL=

# Free-quota YouTube Data API v3 server key. Never enter it in the game.
YOUTUBE_API_KEY=

# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=

# Optional comma-separated exact origins for trusted additional POST clients.
ALLOWED_ORIGINS=
STATS_PUBLIC=true
